{
  "dataset_name": "canonical_erp_ontology",
  "description": "跨ERP标准语义层 v1 - 用于语义编译器的基准目标结构",
  "fields": {
    "partner_id": {
      "type": "string",
      "entity": "BusinessPartner",
      "description": "业务伙伴唯一标识"
    },
    "partner_type": {
      "type": "string",
      "entity": "BusinessPartner",
      "description": "CUSTOMER / VENDOR / BOTH"
    },
    "name": {
      "type": "string",
      "entity": "BusinessPartner",
      "description": "伙伴名称"
    },
    "product_id": {
      "type": "string",
      "entity": "Product",
      "description": "产品唯一标识"
    },
    "product_name": {
      "type": "string",
      "entity": "Product",
      "description": "产品名称"
    },
    "base_uom": {
      "type": "string",
      "entity": "Product",
      "description": "基本计量单位"
    },
    "document_id": {
      "type": "string",
      "entity": "CommercialDocument",
      "description": "单据号"
    },
    "doc_type": {
      "type": "string",
      "entity": "CommercialDocument",
      "description": "SALES_ORDER / PURCHASE_ORDER / AR_INVOICE / AP_INVOICE / POS_TRANSACTION"
    },
    "document_date": {
      "type": "date",
      "entity": "CommercialDocument",
      "description": "单据日期"
    },
    "currency": {
      "type": "string",
      "entity": "CommercialDocument",
      "description": "货币代码"
    },
    "total_amount": {
      "type": "float",
      "entity": "CommercialDocument",
      "description": "单据总额",
      "fallback_strategy": "USE_ZERO"
    },
    "line_id": {
      "type": "string",
      "entity": "CommercialDocumentLine",
      "description": "行项目ID"
    },
    "quantity": {
      "type": "float",
      "entity": "CommercialDocumentLine",
      "description": "数量"
    },
    "unit_price": {
      "type": "float",
      "entity": "CommercialDocumentLine",
      "description": "单价"
    },
    "line_amount": {
      "type": "float",
      "entity": "CommercialDocumentLine",
      "description": "行金额"
    },
    "movement_id": {
      "type": "string",
      "entity": "InventoryMovement",
      "description": "库存移动ID"
    },
    "movement_type": {
      "type": "string",
      "entity": "InventoryMovement",
      "description": "IN / OUT / TRANSFER / ADJUSTMENT"
    },
    "warehouse_id": {
      "type": "string",
      "entity": "InventoryMovement",
      "description": "仓库ID"
    },
    "journal_id": {
      "type": "string",
      "entity": "JournalEntry",
      "description": "凭证号"
    },
    "posting_date": {
      "type": "date",
      "entity": "JournalEntry",
      "description": "过账日期"
    },
    "total_debit": {
      "type": "float",
      "entity": "JournalEntry",
      "description": "借方总额"
    },
    "total_credit": {
      "type": "float",
      "entity": "JournalEntry",
      "description": "贷方总额"
    },
    "account_code": {
      "type": "string",
      "entity": "JournalEntryLine",
      "description": "会计科目"
    },
    "debit": {
      "type": "float",
      "entity": "JournalEntryLine",
      "description": "借方金额"
    },
    "credit": {
      "type": "float",
      "entity": "JournalEntryLine",
      "description": "贷方金额"
    }
  },
  "odcs_contracts": {
    "row_level_rules": [],
    "dataset_level_rules": [],
    "global_invariants": [
      {
        "name": "double_entry_invariant",
        "type": "double_entry",
        "rule": "SUM(debit) == SUM(credit)",
        "apply_to": "JournalEntryLine",
        "severity": "error"
      },
      {
        "name": "invoice_line_consistency",
        "type": "line_sum_consistency",
        "rule": "total_amount == line_amount_sum",
        "apply_to": "CommercialDocument",
        "severity": "error"
      }
    ]
  }
}