{
  "dataset_name": "canonical_erp_ontology",
  "description": "Cross-ERP standard semantic layer v1 - benchmark target structure for the semantic compiler",
  "fields": {
    "partner_id": {
      "type": "string",
      "entity": "BusinessPartner",
      "description": "Unique identifier for business partner"
    },
    "partner_type": {
      "type": "string",
      "entity": "BusinessPartner",
      "description": "CUSTOMER / VENDOR / BOTH"
    },
    "name": {
      "type": "string",
      "entity": "BusinessPartner",
      "description": "Partner name"
    },
    "product_id": {
      "type": "string",
      "entity": "Product",
      "description": "Unique identifier for product"
    },
    "product_name": {
      "type": "string",
      "entity": "Product",
      "description": "Product name"
    },
    "base_uom": {
      "type": "string",
      "entity": "Product",
      "description": "Base unit of measure"
    },
    "document_id": {
      "type": "string",
      "entity": "CommercialDocument",
      "description": "Document number"
    },
    "doc_type": {
      "type": "string",
      "entity": "CommercialDocument",
      "description": "SALES_ORDER / PURCHASE_ORDER / AR_INVOICE / AP_INVOICE / POS_TRANSACTION"
    },
    "document_date": {
      "type": "date",
      "entity": "CommercialDocument",
      "description": "Document date"
    },
    "currency": {
      "type": "string",
      "entity": "CommercialDocument",
      "description": "Currency code"
    },
    "total_amount": {
      "type": "float",
      "entity": "CommercialDocument",
      "description": "Total document amount",
      "fallback_strategy": "USE_ZERO"
    },
    "line_id": {
      "type": "string",
      "entity": "CommercialDocumentLine",
      "description": "Line item ID"
    },
    "quantity": {
      "type": "float",
      "entity": "CommercialDocumentLine",
      "description": "Quantity"
    },
    "unit_price": {
      "type": "float",
      "entity": "CommercialDocumentLine",
      "description": "Unit price"
    },
    "line_amount": {
      "type": "float",
      "entity": "CommercialDocumentLine",
      "description": "Line amount"
    },
    "movement_id": {
      "type": "string",
      "entity": "InventoryMovement",
      "description": "Inventory movement ID"
    },
    "movement_type": {
      "type": "string",
      "entity": "InventoryMovement",
      "description": "IN / OUT / TRANSFER / ADJUSTMENT"
    },
    "warehouse_id": {
      "type": "string",
      "entity": "InventoryMovement",
      "description": "Warehouse ID"
    },
    "journal_id": {
      "type": "string",
      "entity": "JournalEntry",
      "description": "Journal entry number"
    },
    "posting_date": {
      "type": "date",
      "entity": "JournalEntry",
      "description": "Posting date"
    },
    "total_debit": {
      "type": "float",
      "entity": "JournalEntry",
      "description": "Total debit amount"
    },
    "total_credit": {
      "type": "float",
      "entity": "JournalEntry",
      "description": "Total credit amount"
    },
    "account_code": {
      "type": "string",
      "entity": "JournalEntryLine",
      "description": "Account code"
    },
    "debit": {
      "type": "float",
      "entity": "JournalEntryLine",
      "description": "Debit amount"
    },
    "credit": {
      "type": "float",
      "entity": "JournalEntryLine",
      "description": "Credit amount"
    }
  },
  "odcs_contracts": {
    "row_level_rules": [
      
      { "column": "partner_id", "assertion": "not_null", "severity": "error" },
      { "column": "partner_id", "assertion": "unique", "severity": "error" },
      { "column": "partner_type", "assertion": "enum_match", "severity": "error", "allowed_values": ["CUSTOMER", "VENDOR", "BOTH"] },
      { "column": "name", "assertion": "not_null", "severity": "error" },
      
      { "column": "product_id", "assertion": "not_null", "severity": "error" },
      { "column": "product_id", "assertion": "unique", "severity": "error" },
      { "column": "product_name", "assertion": "not_null", "severity": "error" },
      { "column": "base_uom", "assertion": "not_null", "severity": "error" },
      
      { "column": "document_id", "assertion": "not_null", "severity": "error" },
      { "column": "document_id", "assertion": "unique", "severity": "error" },
      { "column": "doc_type", "assertion": "enum_match", "severity": "error", "allowed_values": ["SALES_ORDER", "PURCHASE_ORDER", "AR_INVOICE", "AP_INVOICE", "POS_TRANSACTION"] },
      { "column": "document_date", "assertion": "not_null", "severity": "error" },
      { "column": "currency", "assertion": "not_null", "severity": "error" },
      { "column": "total_amount", "assertion": "non_negative", "severity": "error" },
      
      { "column": "line_id", "assertion": "not_null", "severity": "error" },
      { "column": "line_id", "assertion": "unique", "severity": "error" },
      { "column": "quantity", "assertion": "non_negative", "severity": "error" },
      { "column": "unit_price", "assertion": "non_negative", "severity": "error" },
      { "column": "line_amount", "assertion": "non_negative", "severity": "error" },
      
      { "column": "movement_id", "assertion": "not_null", "severity": "error" },
      { "column": "movement_id", "assertion": "unique", "severity": "error" },
      { "column": "movement_type", "assertion": "enum_match", "severity": "error", "allowed_values": ["IN", "OUT", "TRANSFER", "ADJUSTMENT"] },
      { "column": "warehouse_id", "assertion": "not_null", "severity": "error" },
      
      { "column": "journal_id", "assertion": "not_null", "severity": "error" },
      { "column": "journal_id", "assertion": "unique", "severity": "error" },
      { "column": "posting_date", "assertion": "not_null", "severity": "error" },
      { "column": "total_debit", "assertion": "non_negative", "severity": "error" },
      { "column": "total_credit", "assertion": "non_negative", "severity": "error" },
      
      { "column": "account_code", "assertion": "not_null", "severity": "error" },
      { "column": "debit", "assertion": "non_negative", "severity": "error" },
      { "column": "credit", "assertion": "non_negative", "severity": "error" }
    ],
    "dataset_level_rules": [
      { "metric": "volume_check", "min_rows": 1 }
    ],
    "global_invariants": [
      {
        "name": "double_entry_invariant",
        "type": "double_entry",
        "rule": "abs(total_amount - line_amount) < 0.01",
        "apply_to": "JournalEntryLine",
        "severity": "error"
      },
      {
        "name": "invoice_line_consistency",
        "type": "line_sum_consistency",
        "rule": "total_amount == line_amount_sum",
        "apply_to": "CommercialDocument",
        "severity": "error"
      }
    ]
  },
  "relationships": [
    {
      "from_entity": "CommercialDocument",
      "to_entity": "CommercialDocumentLine",
      "cardinality": "1:N",
      "via": "document_id",
      "description": "A document can have multiple lines."
    },
    {
      "from_entity": "BusinessPartner",
      "to_entity": "CommercialDocument",
      "cardinality": "1:N",
      "via": "partner_id",
      "description": "A partner can have multiple documents."
    },
    {
      "from_entity": "JournalEntry",
      "to_entity": "JournalEntryLine",
      "cardinality": "1:N",
      "via": "journal_id",
      "description": "A journal entry can have multiple lines."
    }
  ],
  "cross_entity_rules": [
    {
      "name": "invoice_must_have_lines",
      "type": "existence_check",
      "source_entity": "CommercialDocument",
      "target_entity": "CommercialDocumentLine",
      "foreign_key": "document_id",
      "severity": "error",
      "description": "Each document must have at least one line item."
    }
  ],
  "lifecycle_states": ["DRAFT", "POSTED", "CLOSED"]
}